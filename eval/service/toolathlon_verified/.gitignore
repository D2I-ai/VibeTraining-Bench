# Per-task run outputs (logs, dumps, eval_res.json, restored trees, retries).
eval_output/

# Byte-compiled
__pycache__/
*.pyc
*.pid
*.log

# Per-host secrets must live OUT of tree (point VTB_TOOLATHLON_VERIFIED_SECRETS
# at them). This is a belt-and-braces guard for an operator who drops a secrets
# tree in-tree instead: never let it be committed.
secrets/
configs/token_key_session.py
configs/gcp-oauth.keys.json
configs/google_credentials.json
configs/global_configs.py
configs/snowflake_rsa_key*
configs/.standalone-mcp.env
configs/.mcp-auth/
