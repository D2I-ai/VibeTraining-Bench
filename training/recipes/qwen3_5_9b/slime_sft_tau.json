{
  "name": "qwen3_5_9b/slime_sft_tau",
  "description": "Tau3-Bench SFT recipe for Qwen3.5-9B-Base. Pinned training corpora: AReaL, Nemotron interactive-agent, and Simia.",
  "compatible_benchmarks": ["sierra-research__tau3-bench"],
  "compatible_model_families": ["Qwen/Qwen3.5-9B", "Qwen/Qwen3.5-9B-Base"],
  "resources": [
    "scripts/slime_sft",
    "models/qwen3_5_9b_base",
    "data/tau_data"
  ],
  "entrypoint_hint": "train_resources/scripts/slime_sft/run_train.sh",
  "validation": {
    "benchmark": "sierra-research__tau3-bench",
    "val_source": "json:${VTB_REPO}/benchmarks/sierra-research__tau3-bench/tau3_val_test_split.json",
    "description": "Published Tau3 split: 35 validation tasks and 340 final tasks; only validation baseline trajectories are mounted into research workspaces."
  },
  "env_defaults": {
    "SLIME_MODEL_CONFIG": "qwen3.5-9B.sh",
    "LOSS_MASK_TYPE": "qwen3_5",
    "NUM_GPUS": "8",
    "TP_SIZE": "2",
    "PP_SIZE": "2",
    "CP_SIZE": "1",
    "MAX_TOKENS_PER_GPU": "20480",
    "MAX_PROMPT_LEN": "20480",
    "ROLLOUT_BATCH_SIZE": "16",
    "GLOBAL_BATCH_SIZE": "16",
    "NUM_EPOCH": "3",
    "SAVE_INTERVAL": "78",
    "SAVE_OPTIM": "0",
    "LR": "1e-5",
    "MIN_LR": "1e-6",
    "LR_WARMUP_FRACTION": "0.05",
    "TRAIN_DATA": "train.jsonl"
  }
}
