    "GLOBAL_BATCH_SIZE": "64",
    "NUM_EPOCH": "1",
    "SAVE_INTERVAL": "1",
    "SAVE_OPTIM": "0",
    "LR": "1e-5",
    "MIN_LR": "1e-6",
    "LR_WARMUP_FRACTION": "0.05",
    "CROSS_ENTROPY_LOSS_FUSION": "1",
    "TRAIN_DATA": "train.jsonl"
  }
