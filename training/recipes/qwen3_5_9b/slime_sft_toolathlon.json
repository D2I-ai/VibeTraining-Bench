{
  "name": "qwen3_5_9b/slime_sft_toolathlon",
  "description": "Toolathlon Gym SFT recipe for Qwen3.5-9B-Base. Pinned dive-mix8000 pool.",
  "compatible_benchmarks": ["eigent-ai__toolathlon_gym"],
  "compatible_model_families": ["Qwen/Qwen3.5-9B-Base"],
  "resources": [
    "scripts/slime_sft",
    "models/qwen3_5_9b_base",
    "data/toolathlon_dive_mix8000"
