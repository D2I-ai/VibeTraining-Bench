{
  "adapter": {
    "added_agents": [
      "tau3-llm-agent"
    ],
    "metadata_source": "VTB_HARBOR_REPO",
    "name": "tau3-bench",
    "original_harness": "agent",
    "parity_matching_agents": [
      "tau3-llm-agent@1.0+gpt-5.2"
    ],
    "path": "adapters/tau3-bench",
    "repo_env": "VTB_HARBOR_REPO",
    "supported_agents": [
      "LLMAgent"
    ]
  },
  "agent": {
    "default": "adapters.tau3-bench.tau3_llm_agent:Tau3LLMAgent",
    "env": "VTB_TAUBENCH_AGENT"
  },
  "agentic": true,
  "agent_kwargs": {
    "llm_args_json": "\"{\\\"extra_body\\\":{\\\"chat_template_kwargs\\\":{\\\"enable_thinking\\\":false}}}\""
  },
  "backend": "harbor",
  "dataset": "sierra-research/tau3-bench",
  "default_limit": 10,
  "dataset_total": 375,
  "environment": "docker",
  "validation_source": "json:${VTB_REPO}/benchmarks/sierra-research__tau3-bench/tau3_val_test_split.json",
  "name": "sierra-research__tau3-bench",
  "notes": "375 tasks across airline, retail, telecom and banking. Conversational, so a coding scaffold under-scores it; set VTB_TAUBENCH_AGENT to tau3's own adapter once the harbor repository checkout is available.",
  "required_env": [
    "VTB_HARBOR_REPO",
    "TAU2_USER_API_KEY",
    "TAU2_USER_BASE_URL",
    "TAU2_USER_MODEL",
    "TAU2_NL_ASSERTIONS_MODEL"
  ]
}
