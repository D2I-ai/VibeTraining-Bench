# Tau3-only deployment configuration. Copy to .env; never commit the copied file.
# Only 1 or true enables domestic network routing. Unset or 0 retains upstream routes.
VTB_DOMESTIC_NETWORK_MODE=0

# Required by the Tau3 adapter. Put secrets in api_key.env when practical.
VTB_HARBOR_REPO=/absolute/path/to/harbor
TAU2_USER_BASE_URL=https://api.example.com/v1
TAU2_NL_ASSERTIONS_BASE_URL=https://api.example.com/v1
TAU2_USER_MODEL=your-model
TAU2_NL_ASSERTIONS_MODEL=your-model
# TAU2_NL_ASSERTIONS_LLM_ARGS_JSON={"temperature":0}

# Tau3 uses an explicit val/test file. Kept for launcher compatibility; uncomment
# to override the launcher's default location.
# TAU3_SPLIT_PATH=${VTB_ROOT}/tau3_val_test_split.json

# Optional existing pip override. It takes precedence in either network mode.
# PIP_INDEX_URL=https://repo.huaweicloud.com/repository/pypi/simple
