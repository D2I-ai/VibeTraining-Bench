{
  "name": "eigent-ai__toolathlon_gym",
  "backend": "customed",
  "agent": "customed",
  "agentic": true,
  "dataset": "eigent-ai/toolathlon_gym",
  "default_limit": 12,
  "dataset_total": 12,
  "environment": "docker",
  "agent_kwargs": {
    "max_steps": 100,
    "llm_call_kwargs": "{\"max_tokens\":8192,\"temperature\":1.0,\"top_p\":1.0,\"top_k\":-1,\"repetition_penalty\":1.0,\"extra_body\":{\"chat_template_kwargs\":{\"enable_thinking\":true}}}",
    "timeout": 900,
    "max_retries": 2
  },
  "notes": "12-task Toolathlon Gym validation benchmark. It uses the custom HTTP adapter and the ordered local manifest; model-call defaults are declared in agent_kwargs."
}
