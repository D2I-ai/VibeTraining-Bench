# api_key.env -- outer-agent API credentials for a training run.
#
# Copy this file to api_key.env (same directory) and fill in ONLY the keys the agent you
# run needs. src/run_task.sh sources api_key.env and forwards these into the agent's
# container. api_key.env is gitignored, so your real keys never get committed.
#
#   cp api_key.env.example api_key.env
#   $EDITOR api_key.env
#
# Only variables named by the selected adapter_config.json are forwarded.
# claude -> ANTHROPIC_API_KEY; codex -> OPENAI_API_KEY (mapped to CODEX_API_KEY).
# Endpoint URLs and model IDs are deployment choices; select RESEARCHER in the launcher.

# --- Anthropic / Claude -------------------------------------------------------
# export ANTHROPIC_API_KEY=""
# export ANTHROPIC_BASE_URL="<your-Anthropic-compatible-base-url>"

# --- OpenAI / Codex -----------------------------------------------------------
# export OPENAI_API_KEY=""
# export OPENAI_BASE_URL="<your-Codex-compatible-base-url>"

# --- OpenRouter / claude_openrouter --------------------------------------------
# OpenRouter key for the claude_openrouter agent; solve.sh sends it as a bearer
# token and blanks ANTHROPIC_API_KEY inside the container (required by the gateway).
# export OPENROUTER_API_KEY=""
# export VTB_OPENROUTER_BASE_URL="<your-compatible-base-url>"

# --- Reasoning effort (outer agent) ---------------------------------------------
# Forwarded only when selected adapter declares the variable.
# export VTB_MAX_THINKING_TOKENS="8192"
# export VTB_EFFORT_LEVEL="high"
# export VTB_MAX_OUTPUT_TOKENS="32000"
# export VTB_CODEX_REASONING_EFFORT="high"
# Private adapter settings belong in a trusted ignored file selected by VTB_LOCAL_ENV_FILE.
